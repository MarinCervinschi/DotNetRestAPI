# Reservations API Tests
@baseUrl = http://localhost:5163

### Get all reservations
GET {{baseUrl}}/Reservations
Accept: application/json

### Get reservation by ID
GET {{baseUrl}}/Reservations/1
Accept: application/json

### Get non-existent reservation (should return 404)
GET {{baseUrl}}/Reservations/999
Accept: application/json

### Get reservations by customer ID
GET {{baseUrl}}/Reservations/customer/1
Accept: application/json

### Get reservations by book ID
GET {{baseUrl}}/Reservations/book/1
Accept: application/json

### Get all books to check their status
GET {{baseUrl}}/Books
Accept: application/json

### Get specific book to verify its status before reservation
GET {{baseUrl}}/Books/1
Accept: application/json

### Create a new reservation
POST {{baseUrl}}/Reservations
Content-Type: application/json

{
  "customerId": 1,
  "bookId": 1
}

### Verify book status changed to Unavailable after reservation
GET {{baseUrl}}/Books/1
Accept: application/json

### Try to create another reservation for the same book (should fail with 409 Conflict)
POST {{baseUrl}}/Reservations
Content-Type: application/json

{
  "customerId": 2,
  "bookId": 1
}

### Create reservation with invalid customer (should return 404)
POST {{baseUrl}}/Reservations
Content-Type: application/json

{
  "customerId": 999,
  "bookId": 2
}

### Create reservation with invalid book (should return 404)
POST {{baseUrl}}/Reservations
Content-Type: application/json

{
  "customerId": 1,
  "bookId": 999
}

### Create a second valid reservation with different book
POST {{baseUrl}}/Reservations
Content-Type: application/json

{
  "customerId": 2,
  "bookId": 2
}

### Get all reservations to see both reservations
GET {{baseUrl}}/Reservations
Accept: application/json

### Get reservations for customer 1
GET {{baseUrl}}/Reservations/customer/1
Accept: application/json

### Get reservations for customer 2
GET {{baseUrl}}/Reservations/customer/2
Accept: application/json

### Get reservations for book 1
GET {{baseUrl}}/Reservations/book/1
Accept: application/json

### Get reservations for book 2
GET {{baseUrl}}/Reservations/book/2
Accept: application/json

### Delete first reservation
DELETE {{baseUrl}}/Reservations/1

### Verify book 1 is now Available again after reservation deletion
GET {{baseUrl}}/Books/1
Accept: application/json

### Create reservation again for the now-available book
POST {{baseUrl}}/Reservations
Content-Type: application/json

{
  "customerId": 3,
  "bookId": 1
}


### Delete non-existent reservation (should return 404)
DELETE {{baseUrl}}/Reservations/999

### Get all books to verify final status
GET {{baseUrl}}/Books
Accept: application/json

### Get all reservations to verify final state
GET {{baseUrl}}/Reservations
Accept: application/json
